# Postgres connection string. Get this from Vercel Postgres, Neon, or Supabase.
# NOTE: if you connect Neon/Postgres through Vercel's Storage tab with a
# custom "environment variable prefix", it will NOT create a plain
# POSTGRES_URL — it creates prefixed names instead (e.g.
# POSTGRES_URL_DATABASE_URL). You don't need to add a separate POSTGRES_URL
# in that case: db/pool.js automatically scans for any env var that holds a
# real Postgres connection string. Just make sure ONE of them has a real
# value and not this placeholder.
POSTGRES_URL=postgres://user:password@host:5432/dbname

# Vercel Blob storage token, for logo/founder/portfolio/client image uploads.
# Create a Blob store in your Vercel project (Storage tab) and it will give you this.
BLOB_READ_WRITE_TOKEN=

# Secret used to sign admin login sessions. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Used only by db/setup.js to create the first admin login.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-now

PORT=3000
NODE_ENV=development
